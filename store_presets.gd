static var _preset_ids: PackedStringArray = PackedStringArray()


#region Stores

## Store ids in table order, e.g. ["steam", "itch", ...].
static func store_ids() -> PackedStringArray:
	return PackedStringArray(STORES.keys())


## The table entry for [param store_id], or an empty dictionary if it is not
## a store we know about.
static func get_store(store_id: String) -> Dictionary:
	return STORES.get(store_id, {})


static func store_label(store_id: String) -> String:
	var store := get_store(store_id)
	return store.get("label", store_id) if store else store_id


## Comma-separated labels for a [constant PROPERTY_HINT_ENUM] int property.
## Index 0 is "Custom"; the rest line up with [method store_ids].
static func store_hint_string() -> String:
	var labels := PackedStringArray(["Custom"])
	for store_id in store_ids():
		labels.append(store_label(store_id))
	return ",".join(labels)


static func store_index(store_id: String) -> int:
	var index := Array(store_ids()).find(store_id)
	return index + 1 if index >= 0 else 0


static func store_at(index: int) -> String:
	var ids := store_ids()
	return ids[index - 1] if index >= 1 and index <= ids.size() else CUSTOM_ID

#endregion


#region Presets

## Every preset id across every store, in table order. Does not include
## [constant CUSTOM_ID].
static func preset_ids() -> PackedStringArray:
	if _preset_ids.is_empty():
		for store_id in STORES:
			for asset_id in STORES[store_id]["assets"]:
				_preset_ids.append(store_id + ID_SEPARATOR + asset_id)
	return _preset_ids


## Preset ids belonging to one store, in table order.
static func preset_ids_for_store(store_id: String) -> PackedStringArray:
	var ids := PackedStringArray()
	var store := get_store(store_id)
	if store.is_empty():
		return ids
	for asset_id in store["assets"]:
		ids.append(store_id + ID_SEPARATOR + asset_id)
	return ids


## The spec dictionary for [param preset_id], or an empty dictionary for
## [constant CUSTOM_ID] and for ids that are no longer in the table.
static func get_preset(preset_id: String) -> Dictionary:
	var parts := preset_id.split(ID_SEPARATOR, false)
	if parts.size() != 2:
		return {}
	var store := get_store(parts[0])
	if store.is_empty():
		return {}
	return store["assets"].get(parts[1], {})


static func has_preset(preset_id: String) -> bool:
	return not get_preset(preset_id).is_empty()


## The store half of a preset id, or "" if there isn't one.
static func store_of(preset_id: String) -> String:
	var parts := preset_id.split(ID_SEPARATOR, false)
	return parts[0] if parts.size() == 2 else CUSTOM_ID


## The asset half of a preset id, or "" if there isn't one.
static func asset_of(preset_id: String) -> String:
	var parts := preset_id.split(ID_SEPARATOR, false)
	return parts[1] if parts.size() == 2 else CUSTOM_ID


static func preset_size(preset_id: String) -> Vector2i:
	return get_preset(preset_id).get("size", Vector2i.ZERO)


static func preset_alpha(preset_id: String) -> String:
	return get_preset(preset_id).get("alpha", ALPHA_OPTIONAL)


## Human-readable name for a dropdown entry. Deliberately comma-free: these
## are joined into a [constant PROPERTY_HINT_ENUM] hint string.
static func preset_label(preset_id: String, include_store: bool = false) -> String:
	var preset := get_preset(preset_id)
	if preset.is_empty():
		return "Custom" if preset_id == CUSTOM_ID else "%s (missing from the preset table)" % preset_id
	var size: Vector2i = preset["size"]
	var label: String = preset["label"]
	if include_store:
		label = "%s - %s" % [store_label(store_of(preset_id)), label]
	if not preset.get("required", false):
		label += " (optional)"
	return "%s  %dx%d" % [label, size.x, size.y]

#endregion


#region Output paths

## Folder name a store's images are written into, relative to the output root.
static func store_folder(store_id: String) -> String:
	var store := get_store(store_id)
	return store.get("folder", store_id) if store else store_id


## Lowercases and strips anything that has no business being in a file or
## folder name, so node names can be used as paths safely.
static func slugify(text: String) -> String:
	var slug := ""
	for character in text.strip_edges().to_lower():
		if character.is_valid_identifier() or character.is_valid_int() or character == "_":
			slug += character
		elif character == "-" or character == ".":
			slug += character
		else:
			slug += "_"
	while slug.contains("__"):
		slug = slug.replace("__", "_")
	return slug.strip_edges(true, true).lstrip("_").rstrip("_")

#endregion

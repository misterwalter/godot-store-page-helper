@tool
class_name StorePresets
extends RefCounted

## The single source of truth for storefront image specs.
##
## Everything else in this tool reads from [member STORES] — the inspector
## dropdowns, the output folder names and the generator's alpha handling. To
## support a new storefront or a new asset, add an entry here and nothing else
## needs to change.
##
## Every size below is quoted from the storefront's own documentation; the URL
## in each store's "docs" field is where it came from. Sizes do go stale, so
## check the docs link before a real submission.

## Preset id used by a [StoreAsset] that sets its own size instead of taking
## one from this table.
const CUSTOM_ID := ""

## The image must be fully opaque. The generator drops the alpha channel and
## warns if anything was transparent.
const ALPHA_NONE := "none"
## The image is meant to sit on top of other art, so it wants a transparent
## background. The generator warns if the result is fully opaque.
const ALPHA_REQUIRED := "required"
## The storefront accepts either.
const ALPHA_OPTIONAL := "optional"

## Separator between the store id and the asset id in a preset id, e.g.
## "steam/library_logo".
